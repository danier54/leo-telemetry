{
  "uid": "leo-satellite-detail",
  "title": "Satellite Detail",
  "tags": ["leo-telemetry"],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "1m",
  "time": { "from": "now-7d", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "satellite",
        "label": "Satellite",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "leo-prometheus" },
        "query": "label_values(leo_telemetry_metric, satellite)",
        "refresh": 2,
        "sort": 1
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Readiness",
      "datasource": { "type": "prometheus", "uid": "leo-prometheus" },
      "gridPos": { "x": 0, "y": 0, "w": 5, "h": 5 },
      "targets": [
        {
          "refId": "A",
          "expr": "leo_telemetry_readiness_score{satellite=\"$satellite\"}",
          "legendFormat": "{{satellite}}"
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "reduceOptions": { "calcs": ["lastNotNull"] }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 0.5 },
              { "color": "green", "value": 0.8 }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Last reading",
      "datasource": { "type": "prometheus", "uid": "leo-prometheus" },
      "gridPos": { "x": 5, "y": 0, "w": 5, "h": 5 },
      "targets": [
        {
          "refId": "A",
          "expr": "time() - leo_telemetry_last_reading_timestamp_seconds{satellite=\"$satellite\"}",
          "legendFormat": "age"
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "reduceOptions": { "calcs": ["lastNotNull"] }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 21600 },
              { "color": "red", "value": 86400 }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Altitude",
      "datasource": { "type": "prometheus", "uid": "leo-prometheus" },
      "gridPos": { "x": 10, "y": 0, "w": 5, "h": 5 },
      "targets": [
        {
          "refId": "A",
          "expr": "leo_telemetry_satellite_altitude_kilometers{satellite=\"$satellite\"}",
          "legendFormat": "altitude"
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "reduceOptions": { "calcs": ["lastNotNull"] }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "lengthkm",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "blue", "value": null }]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Orbital speed",
      "datasource": { "type": "prometheus", "uid": "leo-prometheus" },
      "gridPos": { "x": 15, "y": 0, "w": 5, "h": 5 },
      "targets": [
        {
          "refId": "A",
          "expr": "leo_telemetry_satellite_velocity_km_s{satellite=\"$satellite\"}",
          "legendFormat": "speed"
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "reduceOptions": { "calcs": ["lastNotNull"] }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "velocitykms",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "blue", "value": null }]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "type": "table",
      "title": "Latest metrics",
      "datasource": { "type": "prometheus", "uid": "leo-prometheus" },
      "gridPos": { "x": 20, "y": 0, "w": 4, "h": 21 },
      "targets": [
        {
          "refId": "A",
          "expr": "leo_telemetry_metric{satellite=\"$satellite\"}",
          "format": "table",
          "instant": true
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "renameByName": {
              "name": "Metric",
              "unit": "Unit",
              "Value": "Value"
            },
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "instance": true,
              "job": true,
              "norad_id": true,
              "satellite": true
            },
            "indexByName": { "Metric": 0, "Value": 1, "Unit": 2 }
          }
        }
      ],
      "options": { "showHeader": true },
      "fieldConfig": {
        "defaults": { "decimals": 2, "custom": { "align": "left" } },
        "overrides": []
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Power (volts)",
      "datasource": { "type": "prometheus", "uid": "leo-prometheus" },
      "gridPos": { "x": 0, "y": 5, "w": 10, "h": 8 },
      "targets": [
        {
          "refId": "A",
          "expr": "leo_telemetry_metric{satellite=\"$satellite\", unit=\"V\"}",
          "legendFormat": "{{name}}"
        },
        {
          "refId": "B",
          "expr": "leo_telemetry_metric{satellite=\"$satellite\", unit=\"mV\"} / 1000",
          "legendFormat": "{{name}}"
        }
      ],
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "volt",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "pointSize": 6,
            "showPoints": "always",
            "spanNulls": 3600000
          }
        },
        "overrides": []
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Thermal (Celsius)",
      "datasource": { "type": "prometheus", "uid": "leo-prometheus" },
      "gridPos": { "x": 10, "y": 5, "w": 10, "h": 8 },
      "targets": [
        {
          "refId": "A",
          "expr": "leo_telemetry_metric{satellite=\"$satellite\", unit=\"C\"}",
          "legendFormat": "{{name}}"
        }
      ],
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "celsius",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "pointSize": 6,
            "showPoints": "always",
            "spanNulls": 3600000
          }
        },
        "overrides": []
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Currents and percentages",
      "datasource": { "type": "prometheus", "uid": "leo-prometheus" },
      "gridPos": { "x": 0, "y": 13, "w": 10, "h": 8 },
      "targets": [
        {
          "refId": "A",
          "expr": "leo_telemetry_metric{satellite=\"$satellite\", unit=~\"mA|%\"}",
          "legendFormat": "{{name}} ({{unit}})"
        }
      ],
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "pointSize": 6,
            "showPoints": "always",
            "spanNulls": 3600000
          }
        },
        "overrides": []
      }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Counters",
      "datasource": { "type": "prometheus", "uid": "leo-prometheus" },
      "gridPos": { "x": 10, "y": 13, "w": 10, "h": 8 },
      "targets": [
        {
          "refId": "A",
          "expr": "leo_telemetry_metric{satellite=\"$satellite\", unit=\"count\"}",
          "legendFormat": "{{name}}"
        }
      ],
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "pointSize": 6,
            "showPoints": "always",
            "spanNulls": 3600000
          }
        },
        "overrides": []
      }
    }
  ]
}
